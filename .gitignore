# --- vol-lab .gitignore ---

# Python / venv
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/

# OS / editor
.DS_Store
*.swp

# Runtime logs (e.g. the snapshot collector daemon) are not committed.
*.log

# Snapshot fixtures ARE committed (they are the test data) — do NOT ignore data/snapshots.
# Generated figures are committed too (README shows them); regenerated by scripts.
